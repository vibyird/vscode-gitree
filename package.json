{
  "name": "gitree",
  "version": "1.0.0",
  "description": "git tree for vscode",
  "engines": {
    "vscode": "^1.103.0"
  },
  "keywords": [
    "git",
    "vscode"
  ],
  "author": "vibyird",
  "publisher": "vibyird",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibyird/vscode-gitree.git"
  },
  "type": "module",
  "main": "./extension.js",
  "l10n": "./assets/l10n",
  "contributes": {
    "configuration": [
      {
        "id": "gitree",
        "title": "Gitree",
        "order": 1,
        "properties": {
          "gitree.statusBar.showItem": {
            "type": "boolean",
            "default": true,
            "description": "%gitree.statusBar.showItem%"
          }
        }
      }
    ],
    "commands": [
      {
        "category": "Gitree",
        "command": "gitree.view",
        "title": "%gitree.graph%"
      },
      {
        "category": "Gitree",
        "command": "gitree.graph.refresh",
        "title": "%gitree.refresh%",
        "icon": "$(refresh)"
      },
      {
        "category": "Gitree",
        "command": "gitree.settings",
        "title": "%gitree.settings%",
        "icon": "$(gear)"
      },
      {
        "category": "Gitree",
        "command": "gitree.branch",
        "title": "%gitree.branch%"
      },
      {
        "category": "Gitree",
        "command": "gitree.tag",
        "title": "%gitree.tag%"
      }
    ],
    "icons": {
      "git-logo": {
        "description": "Git Icon",
        "default": {
          "fontPath": "assets/icons/icons.woff",
          "fontCharacter": "\\E900"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "gitree.graph.refresh",
          "when": "view == gitree.graph",
          "group": "navigation@98"
        },
        {
          "command": "gitree.settings",
          "when": "view == gitree.graph",
          "group": "navigation@99"
        }
      ],
      "webview/context": [
        {
          "command": "gitree.branch",
          "when": "webviewId == gitree.graph && webviewSection == commit"
        },
        {
          "command": "gitree.tag",
          "when": "webviewId == gitree.graph && webviewSection == commit"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "gitree",
          "title": "Gitree",
          "icon": "$(git-logo)"
        }
      ]
    },
    "views": {
      "gitree": [
        {
          "type": "webview",
          "id": "gitree.graph",
          "name": "%gitree.graph%",
          "icon": "$(git-logo)"
        }
      ]
    }
  },
  "activationEvents": [
    "onWebviewPanel:gitree.settings",
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "scripts": {
    "vscode:prepublish": "node build/build.js",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "package": "mkdir -p dist && vsce package -o dist/gitree.vsix ",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.0",
    "@types/vscode": "^1.103.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "rolldown": "^1.2.9",
    "sass": "^1.104.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
